# Development Environment Variables

# Environment
ENVIRONMENT=development

# Database Configuration
# Replace with your development database URL
DEV_DATABASE_URL=postgresql://user:password@host:5432/dev_database

# Backend Security
# Generate a secure random key for development
DEV_SECRET_KEY=your-dev-secret-key-change-this-to-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AWS Configuration
# Use development AWS credentials
DEV_AWS_ACCESS_KEY_ID=your-dev-aws-access-key
DEV_AWS_SECRET_ACCESS_KEY=your-dev-aws-secret-key
AWS_REGION=us-west-1

# AI Services
# Use development API key
DEV_ANTHROPIC_API_KEY=your-dev-anthropic-api-key

# CORS Origins (automatically configured in docker-compose.dev.yml)
# CORS_ORIGINS=https://devapp.safespacelabs.cloud,http://localhost:3000

# Frontend Build Args (set in docker-compose.dev.yml)
# REACT_APP_API_URL=https://devapi.safespacelabs.cloud
# REACT_APP_ENV=development
