# Staging Environment Variables

# Environment
ENVIRONMENT=staging

# Database Configuration
# Replace with your staging database URL (should be separate from production)
STAGING_DATABASE_URL=postgresql://user:password@host:5432/staging_database

# Backend Security
# Generate a strong random key for staging
STAGING_SECRET_KEY=your-staging-secret-key-change-this-to-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AWS Configuration
# Use staging AWS credentials (separate from production)
STAGING_AWS_ACCESS_KEY_ID=your-staging-aws-access-key
STAGING_AWS_SECRET_ACCESS_KEY=your-staging-aws-secret-key
AWS_REGION=us-west-1

# AI Services
# Use staging API key
STAGING_ANTHROPIC_API_KEY=your-staging-anthropic-api-key

# CORS Origins (automatically configured in docker-compose.staging.yml)
# CORS_ORIGINS=https://qaapp.safespacelabs.cloud

# Frontend Build Args (set in docker-compose.staging.yml)
# REACT_APP_API_URL=https://qaapi.safespacelabs.cloud
# REACT_APP_ENV=staging
