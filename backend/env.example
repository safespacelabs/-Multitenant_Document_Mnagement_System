# Database Configuration
MANAGEMENT_DATABASE_URL=postgresql://postgres:password@localhost:5432/document_management
DATABASE_URL=postgresql://postgres:password@localhost:5432/document_management

# Security Settings
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AWS Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1

# AI Service Configuration
ANTHROPIC_API_KEY=your-anthropic-api-key

# Neon Database Configuration
NEON_API_KEY=your-neon-api-key
NEON_PROJECT_ID=your-neon-project-id

# Email Service Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=noreply@yourcompany.com
SENDER_PASSWORD=your-email-password
SENDER_NAME=Document Management System

# Application Settings
APP_URL=http://localhost:3000

# Feature Flags
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_DOCUMENT_NOTIFICATIONS=true
ENABLE_ESIGNATURE_NOTIFICATIONS=true

# Environment
ENVIRONMENT=development
